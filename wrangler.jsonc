/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-cf-template",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "development",
    "VITE_ENVIRONMENT": "development",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "mail-queue",
      },
    ],
    "consumers": [
      {
        "queue": "mail-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 5,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "NotificationDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NotificationDurableObject"],
    },
  ],
  "env": {
    "staging": {
      "name": "tanstack-start-cf-template",
      "vars": {
        "ENVIRONMENT": "staging",
        "VITE_ENVIRONMENT": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "db-stage",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATIONS",
            "class_name": "NotificationDurableObject",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "mail-queue",
          },
        ],
        "consumers": [
          {
            "queue": "mail-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
    },
    "production": {
      "name": "tanstack-start-cf-template",
      "vars": {
        "ENVIRONMENT": "production",
        "VITE_ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATIONS",
            "class_name": "NotificationDurableObject",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "mail-queue",
          },
        ],
        "consumers": [
          {
            "queue": "mail-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
    },
  },
}
