{
  "name": "tanstack-start-cf-template",
  "private": true,
  "type": "module",
  "license": "MIT",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" && eslint --fix",
    "check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "commit": "cz",
    "prepare": "husky",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/tanstack-react": "^10.6.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/eslint-config": "0.5.0",
    "@tanstack/react-query": "latest",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "latest",
    "wrangler": "^4.166.0"
  }
}
