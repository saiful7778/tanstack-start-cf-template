{
	"name": "tanstack-start-cf-template",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"lint": "eslint",
		"format": "prettier --write . && eslint --fix",
		"check": "prettier --check .",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.15",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.4",
		"@tanstack/react-start": "1.169.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/devtools-vite": "0.8.7",
		"@tanstack/eslint-config": "0.5.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^9.20.0",
		"prettier": "^3.8.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.166.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}